---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { CONTACT_INFO } from '../consts';

const services = [
	{
		title: 'PAQUETES DE MARKETING DIGITAL',
		description: 'INCLUYE SOCIAL MEDIA MANAGEMENT CREACION DE CONTENIDO, SESIONES Y MUCHO MAS.',
		href: '/paquetes',
		icon: '/images/home/caja-social.png',
	},
	{
		title: 'ESTUDIOS DE MERCADO',
		description: 'IDEAL PARA INVERSIONISTAS O PARA ESTABLECER SU ESTRATEGIA DE MARKETING.',
		href: '/estudio-de-mercado',
		icon: '/images/home/caja-estudio-mercado.png',
	},
	{
		title: 'CURSOS Y CAPACITACIONES',
		description: 'CURSOS COMPLETOS DE MARKETING DIGITAL.',
		href: '/cursos',
		icon: '/images/home/caja-cursos.png',
	},
];

---

<Layout>
	<section id='hero' class='w-full'>
		<!-- Imagen grande arriba, sin fondo, sin padding lateral -->
		<div class='w-full pt-8' data-reveal>
			<img src='/images/PORTADA INICIAL copia.png' alt='Equipo Twinbox' class='w-full object-contain' style='max-height: 55vh;' />
		</div>

		<!-- Texto debajo de la imagen -->
		<div class='container-brand py-14 text-center flex flex-col items-center' data-reveal>
			<p class='text-sm font-semibold uppercase tracking-[0.24em] text-brand-accent'>Agencia de publicidad y marketing digital en México</p>
			<h1 class='mt-4 font-heading text-5xl leading-tight md:text-7xl'>AGENCIA DE PUBLICIDAD Y MARKETING DIGITAL EN MÉXICO</h1>
			<p class='mt-6 max-w-2xl text-lg leading-relaxed text-brand-main/80'>Con más de 10 años de experiencia, ayudamos a empresas y negocios a posicionarse, vender y crecer con una operación digital integral.</p>
			<div class='mt-10 flex flex-wrap justify-center gap-4'>
				<Button href='/contacto'>CONTACTANOS</Button>
				<Button href='/paquetes' variant='outline'>PAQUETES</Button>
			</div>
			<div class='mt-10 grid w-full max-w-xl grid-cols-3 gap-3 text-center'>
				<div class='rounded-2xl border border-brand-main/10 px-3 py-4'>
					<p class='font-heading text-2xl'>+10</p>
					<p class='text-xs uppercase tracking-[0.12em] text-brand-main/70'>Años</p>
				</div>
				<div class='rounded-2xl border border-brand-main/10 px-3 py-4'>
					<p class='font-heading text-2xl'>+10</p>
					<p class='text-xs uppercase tracking-[0.12em] text-brand-main/70'>Ciudades</p>
				</div>
				<div class='rounded-2xl border border-brand-main/10 px-3 py-4'>
					<p class='font-heading text-2xl'>24/7</p>
					<p class='text-xs uppercase tracking-[0.12em] text-brand-main/70'>Atención</p>
				</div>
			</div>
		</div>
	</section>

	<section class='container-brand pb-10'>
		<div class='glass-panel mx-auto max-w-4xl p-4 md:p-5' data-reveal>
			<p class='text-center font-heading text-[10px] font-semibold uppercase tracking-[0.06em] text-brand-accent md:text-sm'>
				TURISMO, BIENES RAICES, ASOCIACIONES, INSTITUCIONAL HOTELERIA, EVENTOS MASIVOS, Y MUCHO MÁS
			</p>
		</div>
	</section>

	<section id='servicios' class='section-space bg-white/60'>
		<div class='container-brand'>
			<div data-reveal>
				<SectionHeading title='NUESTROS SERVICIOS' subtitle='ELIGE LOS SERIVICIOS DE MARKETING QUE SE AJUSTE A LAS NECESIDADES DE TU MARCA' />
			</div>
			<div class='mt-12 grid gap-6 lg:grid-cols-3'>
				{services.map((service) => (
					<article class='flex h-full flex-col rounded-3xl border border-brand-main/10 bg-white p-3 shadow-soft transition-all duration-300 hover:-translate-y-1' data-reveal>
						<div class='rounded-2xl border border-dashed border-brand-main/25 bg-brand-bg p-3'>
							<img src={service.icon} alt={service.title} class='h-28 w-full object-contain object-center md:h-32' />
						</div>
						<div class='flex flex-1 flex-col p-4 text-center'>
							<h3 class='rounded-md bg-black px-2 py-1 font-heading text-base font-semibold uppercase tracking-[0.02em] text-white md:text-lg'>{service.title}</h3>
							<p class='mt-3 min-h-[78px] text-base font-semibold uppercase leading-snug text-brand-main/90 md:text-lg'>{service.description}</p>
							<a href={service.href} class='mt-auto inline-flex self-center rounded-md bg-[#2f7f2f] px-4 py-2 text-sm font-extrabold uppercase leading-none text-white transition-colors hover:bg-[#256825]'>Solicitar ahora</a>
						</div>
					</article>
				))}
			</div>
			<div class='mt-10 flex flex-wrap gap-3 text-sm'>
				<a href='/branding' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>Branding e identidad de marca</a>
				<a href='/clinica-de-marketing' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>Clínica de Marketing</a>
				<a href='/cursos' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>Cursos</a>
				<a href='/ecommerce' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>E-commerce</a>
				<a href='/estudio-de-mercado' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>Estudio de mercado</a>
				<a href='/paquetes' class='rounded-full border border-brand-main/15 bg-brand-bg px-4 py-2 hover:border-brand-accent hover:text-brand-accent'>Paquetes</a>
			</div>
		</div>
	</section>

	<section id='marcas' class='section-space bg-white'>
		<div class='container-brand'>
			<div data-reveal>
				<SectionHeading title='Marcas que confiaron en nosotros' subtitle='Empresas y organizaciones que han crecido junto a Twinbox Agency.' />
			</div>
			<div class='mt-10' data-reveal>
				<img src='/images/home/marcas-historial.png' alt='Marcas que han confiado en Twinbox Agency' class='w-full object-contain' />
			</div>
		</div>
	</section>

	<section id='contacto' class='section-space bg-white/70'>
		<div class='container-brand grid gap-12 lg:grid-cols-2'>
			<div data-reveal>
				<SectionHeading title='Contacto' subtitle='Cuéntanos tu objetivo y preparamos una propuesta estratégica adaptada a tu industria.' />
				<ul class='mt-8 space-y-3 text-sm text-brand-main/90'>
					<li>Email: <a href={`mailto:${CONTACT_INFO.email}`} class='text-brand-accent'>{CONTACT_INFO.email}</a></li>
					<li>
						<a href={CONTACT_INFO.whatsappPrimaryUrl} class='inline-flex rounded-full border border-[#1f8e44]/30 bg-[#e7f8ef] px-3 py-1 font-semibold text-[#1f8e44] transition-colors hover:bg-[#d9f3e5]' target='_blank' rel='noreferrer'>
							Botón de WhatsApp: {CONTACT_INFO.whatsappPrimaryLabel}
						</a>
					</li>
					<li>Contacto secundario: <a href={CONTACT_INFO.secondaryWhatsAppUrl} class='text-brand-accent' target='_blank' rel='noreferrer'>{CONTACT_INFO.secondaryLabel}</a></li>
					<li>
						<a href={CONTACT_INFO.googleBusinessProfile} class='text-brand-accent' target='_blank' rel='noreferrer'>Google Perfil de Negocio</a>
					</li>
				</ul>
			</div>
			<form class='rounded-3xl border border-brand-main/10 bg-brand-bg p-8 shadow-soft' data-reveal>
				<div class='grid gap-4 md:grid-cols-2'>
					<input type='text' placeholder='Nombre' class='rounded-xl border border-brand-main/15 bg-white px-4 py-3 text-sm outline-none focus:border-brand-accent' />
					<input type='email' placeholder='Email' class='rounded-xl border border-brand-main/15 bg-white px-4 py-3 text-sm outline-none focus:border-brand-accent' />
					<input type='text' placeholder='Teléfono' class='rounded-xl border border-brand-main/15 bg-white px-4 py-3 text-sm outline-none focus:border-brand-accent md:col-span-2' />
					<textarea rows='5' placeholder='Cuéntanos sobre tu proyecto' class='rounded-xl border border-brand-main/15 bg-white px-4 py-3 text-sm outline-none focus:border-brand-accent md:col-span-2'></textarea>
				</div>
				<Button class='mt-6 w-full' type='submit'>Enviar mensaje</Button>
			</form>
		</div>
	</section>
</Layout>
